<script>
  function filterCards(domain, btn) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const cards = document.querySelectorAll('.spec-card');
    let visible = 0;
    cards.forEach(card => {
      if (domain === 'all' || card.dataset.domain === domain) {
        card.classList.remove('hidden');
        visible++;
      } else {
        card.classList.add('hidden');
      }
    });

    const countEl = document.getElementById('count');
    if (countEl) {
      const total = document.querySelectorAll('#specs-grid .spec-card').length;
      countEl.textContent = domain === 'all'
        ? `${total} specifications`
        : `${visible} specification${visible !== 1 ? 's' : ''} shown`;
    }
  }
</script>
